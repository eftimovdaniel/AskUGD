# Kopiraj vo .env i popolni gi vrednostite.
# pydantic-settings gi cita ovaa iminja (case-insensitive).

# --- LLM ---
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile

# --- Qdrant ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=AskUGD

# --- Redis (zadolzitelno za start-prod.sh / 2+ workers) ---
# Spodeluva history, answer cache, rate limit i LLM budget megju workers.
REDIS_URL=redis://127.0.0.1:6379/0

# 1 worker na free host: sekoj worker gi drzi modelite pak vo RAM (~4-6 GB).
WEB_CONCURRENCY=1

# --- Bezbednost ---
# Potrebno za potpisani session_id koga ima povekje workers.
SESSION_SECRET=
API_ACCESS_KEY=
CORS_ORIGINS=

# --- Budzet (0 = iskluceno) ---
LLM_MAX_CALLS_PER_HOUR=0
LLM_MAX_CALLS_PER_DAY=0

# --- Document API (vlecenje PDF od uni baza) ---
# DOC_API_URL=https://api.primer.mk
# DOC_API_TOKEN=
DOC_API_URL=
DOC_API_TOKEN=
