# ==== LLM (OpenAI-компатибилен API: OpenAI, Groq...) ====
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile

# ==== Qdrant ====
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=askugd

# ==== Retrieval ====
TOP_K=3

# ==== Безбедност ====
# API_ACCESS_KEY=
CORS_ORIGINS=https://www.ugd.edu.mk
RATE_LIMIT=20
RATE_LIMIT_IP=300
# TRUST_PROXY_HEADERS=true
# TRUSTED_PROXY_HOPS=1

# ==== Redis (само со 2+ workers) ====
# REDIS_URL=redis://localhost:6379/0
